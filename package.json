{
  "name": "collab-review-layer",
  "version": "0.0.0-prealpha",
  "description": "An open-source collaborative review layer for live web prototypes and deploy previews. Enables Figma-style collaborative feedback for live prototypes, anywhere.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./styles.css": "./dist/review-shell.css",
    "./overlay.css": "./dist/review-overlay.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tushark88/collab-review-layer.git"
  },
  "bugs": {
    "url": "https://github.com/tushark88/collab-review-layer/issues"
  },
  "homepage": "https://github.com/tushark88/collab-review-layer#readme"
}
